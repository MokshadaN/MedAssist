# LAN host that phones on the same Wi-Fi can use to reach this dev machine.
# Used by getShareableOrigin() in src/api.ts so the emergency QR code points
# to a reachable address instead of `localhost` (which a scanning phone would
# resolve to itself). Update this if your Wi-Fi IP changes (run `ipconfig`).
VITE_PUBLIC_HOST=192.168.1.34

# ============================================================
# MedAssist Environment Configuration
# ============================================================
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
ENVIRONMENT=development         # "development" | "production"

# ── Security ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Token expiry (optional overrides — defaults shown)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────
# Development (SQLite — default, no setup needed):
DATABASE_URL=sqlite:///./medassist.db

# Production (PostgreSQL — uncomment and configure):
# DATABASE_URL=postgresql+psycopg2://medassist:your_password@localhost:5432/medassist
# DB_USER=medassist
# DB_PASSWORD=your_strong_password_here

# ── Report processing ─────────────────────────────────────────
# API and worker must use the same durable directory outside local development.
UPLOAD_DIR=./uploads/reports
# Must remain longer than the Celery hard task limit (10 minutes).
REPORT_ANALYSIS_STALE_MINUTES=15
RISK_CHECK_STALE_MINUTES=15

# ── Redis ─────────────────────────────────────────────────────
# Required for rate limiting and Celery task queue
# REDIS_PASSWORD=your_redis_password_here

# ── AI APIs ───────────────────────────────────────────────────
# Google Gemini (report analysis + intake summarization)
GOOGLE_API_KEY=your_google_api_key_here

# OPTIONAL — multiple Gemini keys for quota rotation (free-tier quotas are
# per Google Cloud project, so create one project per key). Comma-separated.
# If set, this replaces GOOGLE_API_KEY as the key list.
# GOOGLE_API_KEYS=first_key_here,second_key_here,third_key_here

# Groq (triage fact extraction + fallback provider when all Gemini keys fail)
GROQ_API_KEY=your_groq_api_key_here
# Groq text models (change here if models are retired — list current ones via
# Groq().models.list()). Triage extraction uses a fast light model; the
# Gemini-fallback path uses the strongest one for SOAP summaries.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# Ordered extraction-only triage fallback chain (maximum 3 models).
GROQ_TRIAGE_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
# Groq Whisper model for voice-to-text (backend STT)
GROQ_STT_MODEL=whisper-large-v3-turbo

# Shadow-only clinical triage classifier. Enabling this does not change live
# urgency decisions; a validated classifier adapter must also be configured.
TRIAGE_CLASSIFIER_SHADOW_ENABLED=false

# Comma-separated Overpass providers used in order for nearby-hospital lookup.
OVERPASS_API_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Hard cap per AI call in seconds — a model that neither answers nor errors
# within this window is abandoned for the next fallback instead of stalling
# clinical flows (default 40).
AI_CALL_TIMEOUT=40

# HuggingFace (PubMedBERT embeddings for drug-risk engine)
HF_TOKEN=your_huggingface_token_here

# ── Email (SMTP) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=noreply@medassist.io
SMTP_TLS=true

# ── WhatsApp Reminders (Twilio) ────────────────────────────────
# Optional — if not set, reminders are logged to console only
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
